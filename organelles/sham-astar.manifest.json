{
  "schema_version": "1",
  "name": "sham-astar",
  "codon": "sa",
  "version": "0.1.0",
  "description": "A* route over a street graph with width/one-way/vehicle-class constraints (organelle)",
  "contracts": [
    {
      "op": "route",
      "description": "A* path from->to over the supplied street graph",
      "input_schema": {
        "type": "object",
        "required": [
          "nodes",
          "streets",
          "from",
          "to",
          "class"
        ],
        "properties": {
          "nodes": {
            "type": "array"
          },
          "streets": {
            "type": "array"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          },
          "class": {
            "type": "string"
          }
        }
      }
    }
  ],
  "authority": {
    "mutation_class": "read_only",
    "declared_valence": "proven",
    "required_capability": null,
    "granted_capabilities": []
  },
  "transports": [
    "native",
    "unix_socket",
    "mcp",
    "rest"
  ],
  "receipt_policy": {
    "content_addressed": true,
    "algorithm": "sha256",
    "chain": true
  }
}
