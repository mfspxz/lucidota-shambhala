{
  "schema_version": "1",
  "name": "sham-ping",
  "codon": "vn",
  "version": "0.1.0",
  "description": "validate a GPS ping: bounds + timestamp sanity (ODIN tracking) (organelle)",
  "contracts": [
    {
      "op": "validate",
      "description": "validate a GPS ping; returns valid + reason on failure",
      "input_schema": {
        "type": "object",
        "required": [
          "lat",
          "lon",
          "ts_ms"
        ],
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "ts_ms": {
            "type": "integer"
          },
          "now_ms": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "authority": {
    "mutation_class": "read_only",
    "declared_valence": "proven",
    "required_capability": null,
    "granted_capabilities": []
  },
  "transports": [
    "native",
    "unix_socket",
    "mcp",
    "rest"
  ],
  "receipt_policy": {
    "content_addressed": true,
    "algorithm": "sha256",
    "chain": true
  }
}
