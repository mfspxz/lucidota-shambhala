{
  "schema_version": "1",
  "name": "sham-zone",
  "codon": "sz",
  "version": "0.1.0",
  "description": "suggest the best zone for a vehicle class (ODIN dispatch) (organelle)",
  "contracts": [
    {
      "op": "suggest_zone",
      "description": "best zone id for a vehicle class given zone capacity/occupancy",
      "input_schema": {
        "type": "object",
        "required": [
          "class",
          "zones"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  ],
  "authority": {
    "mutation_class": "read_only",
    "declared_valence": "proven",
    "required_capability": null,
    "granted_capabilities": []
  },
  "transports": [
    "native",
    "unix_socket",
    "mcp",
    "rest"
  ],
  "receipt_policy": {
    "content_addressed": true,
    "algorithm": "sha256",
    "chain": true
  }
}
